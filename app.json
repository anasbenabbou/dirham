{
  "expo": {
    "name": "dirham",
    "slug": "dirham",
    "scheme": "dirham",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anasbenabbou.dirham"
    },
    "android": {
      "package": "com.anasbenabbou.dirham",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-dev-client",
      "./plugins/withBvcCert"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cde84ff0-605c-46af-87f7-eb2cc778ba07"
      }
    },
    "owner": "anasben03"
  }
}
