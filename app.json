{
  "expo": {
    "name": "Dirham",
    "slug": "dirham",
    "scheme": "dirham",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anasbenabbou.dirham"
    },
    "android": {
      "package": "com.anasbenabbou.dirham",
      "adaptiveIcon": {
        "backgroundColor": "#0B1640",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-dev-client",
      "./plugins/withBvcCert",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0E11",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cde84ff0-605c-46af-87f7-eb2cc778ba07"
      }
    },
    "owner": "anasben03"
  }
}
